# ─── Database ────────────────────────────────────────────────
# MongoDB Atlas connection string (include the database name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tuition-teacher-pokhara?retryWrites=true&w=majority

# ─── Cloudinary (CV + logo storage) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Initial administrator (used only by `npm run seed:admin`) ─
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ─── Sessions ────────────────────────────────────────────────
# Secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ─── Public URL ──────────────────────────────────────────────
# Production domain, e.g. https://tuition-teacher-pokhara.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
